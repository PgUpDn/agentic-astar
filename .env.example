# ── Discord ───────────────────────────────────────────────────────
DISCORD_TOKEN=your-discord-bot-token
DISCORD_GUILD_ID=0                       # your server's ID (right-click server → Copy ID)

# ── LLM (OpenAI-compatible) ──────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini                # or gpt-4o, deepseek-chat, etc.

# ── Simulation tuning ────────────────────────────────────────────
TICK_INTERVAL=30                         # seconds between agent mailbox checks
MAX_MEMORY=50                            # messages kept per agent
AGENT_COOLDOWN=5                         # min seconds between LLM calls per agent

LOG_LEVEL=INFO
